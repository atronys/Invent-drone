// HTTP-сервис обмена стенда RackScan с конфигурацией на платформе «1С:Предприятие 8.3».
//
// ШАБЛОН. В действующей базе не запускался. Имена объектов метаданных ниже — ЗАГЛУШКИ,
// отмеченные «// ЗАМЕНИТЬ»: в конфигурации «1С:WMS Логистика. Управление складом» справочник
// ячеек, регистр остатков и документ инвентаризации называются по-своему. Узнать имена:
// Конфигуратор -> дерево метаданных, либо командой стенда:
//   python -m rackscan wms discover --url http://сервер/база/odata/standard.odata
// (она читает $metadata и отбирает объекты ячеек, контейнеров, остатков и инвентаризации).
// По официальному описанию редакции 5: инвентаризация оформляется документом «Плановая
// инвентаризация», работа по ячейке — задачей на пересчёт типа «Пересчет ячейки».
//
// Как подключить:
//   1. Создать расширение конфигурации, добавить HTTP-сервис: имя РэкСкан, корневой URL rackscan.
//   2. Добавить шаблоны URL и методы (обработчик — функция этого модуля):
//        /v1/ping                      GET   -> PingGET
//        /v1/cells                     GET   -> CellsGET
//        /v1/stock                     GET   -> StockGET
//        /v1/inventory                 POST  -> InventoryPOST
//        /v1/inventory/{id}            GET   -> InventoryGET
//        /v1/inventory/{id}/results    POST  -> ResultsPOST
//        /v1/inventory/{id}/close      POST  -> ClosePOST
//   3. Опубликовать базу на веб-сервере с включёнными HTTP-сервисами расширений.
//   4. Завести пользователя для стенда с ролью, дающей чтение остатков и запись результатов.
//   Адрес для настроек стенда: http://сервер/база/hs/rackscan/v1
//
// Где хранить результат. В шаблоне строки задания и результаты пишутся в регистр сведений
// расширения «РэкСканСтрокиЗаданий» (измерения: Задание, Адрес; ресурсы: Ожидалось, Найдено,
// СтатусСканирования, Вердикт, Признаки, Примечание, Фото, Момент). Так обмен не зависит от
// устройства штатного документа инвентаризации; перенос итогов в штатный документ делается
// отдельной обработкой после проверки расхождений человеком.

#Область Обработчики

Функция PingGET(Запрос)
	Возврат ОтветJSON(Новый Структура("service, version, backend", "rackscan", 1, "1c"));
КонецФункции

Функция CellsGET(Запрос)
	ЗапросДанных = Новый Запрос(
	"ВЫБРАТЬ
	|	Ячейки.Наименование КАК Адрес
	|ИЗ
	|	Справочник.Ячейки КАК Ячейки              // ЗАМЕНИТЬ: справочник ячеек
	|ГДЕ
	|	НЕ Ячейки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Адрес");
	Адреса = ЗапросДанных.Выполнить().Выгрузить().ВыгрузитьКолонку("Адрес");
	Возврат ОтветJSON(Новый Структура("cells", Адреса));
КонецФункции

Функция StockGET(Запрос)
	Адрес = Запрос.ПараметрыЗапроса.Получить("cell");
	Возврат ОтветJSON(Новый Структура("stock", ОстаткиПоЯчейкам(Адрес)));
КонецФункции

Функция InventoryPOST(Запрос)
	Тело = ТелоКакСтруктура(Запрос);
	Адреса = ?(Тело.Свойство("cells"), Тело.cells, Неопределено);
	Остатки = ОстаткиПоЯчейкам(Неопределено);

	// учётные остатки фиксируются на момент создания задания
	ПоАдресам = Новый Соответствие;
	Если Адреса = Неопределено Тогда
		Адреса = CellsСписок();
	КонецЕсли;
	Для Каждого Адрес Из Адреса Цикл
		ПоАдресам.Вставить(Адрес, Новый Массив);
	КонецЦикла;
	Для Каждого Строка Из Остатки Цикл
		Список = ПоАдресам.Получить(Строка.address);
		Если Список <> Неопределено Тогда
			Список.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Идентификатор = Строка(Новый УникальныйИдентификатор);
	Момент = ТекущаяДатаСеанса();
	Строки = Новый Массив;
	Для Каждого Адрес Из Адреса Цикл
		Ожидалось = ПоАдресам.Получить(Адрес);
		Запись = РегистрыСведений.РэкСканСтрокиЗаданий.СоздатьМенеджерЗаписи();
		Запись.Задание = Идентификатор;
		Запись.Адрес = Адрес;
		Запись.Ожидалось = ВСтрокуJSON(Ожидалось);
		Запись.Создано = Момент;
		Запись.Записать();
		Строки.Добавить(Новый Структура("address, expected", Адрес, Ожидалось));
	КонецЦикла;

	Результат = Новый Структура("id, created, status, lines",
		Идентификатор, ЗаписатьДатуJSON(Момент, ФорматДатыJSON.ISO), "open", Строки);
	Возврат ОтветJSON(Результат, 201);
КонецФункции

Функция ResultsPOST(Запрос)
	Идентификатор = Запрос.ПараметрыURL.Получить("id");
	Тело = ТелоКакСтруктура(Запрос);
	Если НЕ Тело.Свойство("address") ИЛИ НЕ Тело.Свойство("scan_status") Тогда
		Возврат ОтветОшибка(400, "нужны поля address и scan_status");
	КонецЕсли;

	Запись = РегистрыСведений.РэкСканСтрокиЗаданий.СоздатьМенеджерЗаписи();
	Запись.Задание = Идентификатор;
	Запись.Адрес = Тело.address;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		Возврат ОтветОшибка(404, "в задании нет такой ячейки");
	КонецЕсли;
	Если Запись.Закрыто Тогда
		Возврат ОтветОшибка(409, "задание закрыто");
	КонецЕсли;

	Ожидалось = Новый Массив;
	Для Каждого Строка Из ИзСтрокиJSON(Запись.Ожидалось) Цикл
		Ожидалось.Добавить(Строка.sscc);
	КонецЦикла;
	Найдено = ?(Тело.Свойство("codes"), Тело.codes, Новый Массив);
	Вердикт = Вердикт(Тело.scan_status, Найдено, Ожидалось);

	Запись.Найдено = ВСтрокуJSON(Найдено);
	Запись.СтатусСканирования = Тело.scan_status;
	Запись.Вердикт = Вердикт.Код;
	Запись.Примечание = Вердикт.Примечание;
	Запись.Признаки = ?(Тело.Свойство("flags"), ВСтрокуJSON(Тело.flags), "[]");
	Запись.Фото = ?(Тело.Свойство("photo"), Тело.photo, "");
	Запись.Момент = ТекущаяДатаСеанса();
	Запись.Записать();

	Возврат ОтветJSON(Новый Структура("address, verdict, note, expected",
		Тело.address, Вердикт.Код, Вердикт.Примечание, Ожидалось));
КонецФункции

Функция InventoryGET(Запрос)
	Возврат ОтветJSON(Ведомость(Запрос.ПараметрыURL.Получить("id")));
КонецФункции

Функция ClosePOST(Запрос)
	Идентификатор = Запрос.ПараметрыURL.Получить("id");
	Набор = РегистрыСведений.РэкСканСтрокиЗаданий.СоздатьНаборЗаписей();
	Набор.Отбор.Задание.Установить(Идентификатор);
	Набор.Прочитать();
	Для Каждого Запись Из Набор Цикл
		Запись.Закрыто = Истина;
	КонецЦикла;
	Набор.Записать();
	Возврат ОтветJSON(Ведомость(Идентификатор));
КонецФункции

#КонецОбласти

#Область Данные

// Остатки по ячейкам: массив структур {address, sscc, sku, name, qty}.
Функция ОстаткиПоЯчейкам(Адрес)
	ЗапросДанных = Новый Запрос(
	"ВЫБРАТЬ
	|	Остатки.Ячейка.Наименование КАК address,
	|	Остатки.Контейнер.Код КАК sscc,                      // ЗАМЕНИТЬ: где хранится SSCC
	|	Остатки.Номенклатура.Артикул КАК sku,
	|	Остатки.Номенклатура.Наименование КАК name,
	|	Остатки.КоличествоОстаток КАК qty
	|ИЗ
	|	РегистрНакопления.ТоварыВЯчейках.Остатки КАК Остатки  // ЗАМЕНИТЬ: регистр остатков
	|ГДЕ
	|	(&Адрес = НЕОПРЕДЕЛЕНО ИЛИ Остатки.Ячейка.Наименование = &Адрес)
	|	И Остатки.КоличествоОстаток > 0");
	ЗапросДанных.УстановитьПараметр("Адрес", Адрес);
	Результат = Новый Массив;
	Выборка = ЗапросДанных.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура("address, sscc, sku, name, qty",
			СокрЛП(Выборка.address), СокрЛП(Выборка.sscc), СокрЛП(Выборка.sku), Выборка.name, Выборка.qty));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция CellsСписок()
	ЗапросДанных = Новый Запрос(
	"ВЫБРАТЬ Ячейки.Наименование КАК Адрес ИЗ Справочник.Ячейки КАК Ячейки   // ЗАМЕНИТЬ
	|ГДЕ НЕ Ячейки.ПометкаУдаления УПОРЯДОЧИТЬ ПО Адрес");
	Возврат ЗапросДанных.Выполнить().Выгрузить().ВыгрузитьКолонку("Адрес");
КонецФункции

// Правила те же, что в rackscan/wms/reconcile.py — менять только вместе.
Функция Вердикт(СтатусСканирования, Найдено, Ожидалось)
	Результат = Новый Структура("Код, Примечание", "NOT_SCANNED", "");
	ОбщихКодов = 0;
	Для Каждого Код Из Найдено Цикл
		Если Ожидалось.Найти(Код) <> Неопределено Тогда
			ОбщихКодов = ОбщихКодов + 1;
		КонецЕсли;
	КонецЦикла;

	Если СтатусСканирования = "EMPTY" Тогда
		Результат.Код = ?(Ожидалось.Количество() = 0, "MATCH", "SHORTAGE");
	ИначеЕсли СтатусСканирования = "READ" Тогда
		Если ОбщихКодов = Найдено.Количество() И ОбщихКодов = Ожидалось.Количество() Тогда
			Результат.Код = "MATCH";
		ИначеЕсли Ожидалось.Количество() = 0 Тогда
			Результат.Код = "SURPLUS";
		ИначеЕсли ОбщихКодов > 0 Тогда
			Результат.Код = "PARTIAL";
		Иначе
			Результат.Код = "MISMATCH";
		КонецЕсли;
	ИначеЕсли СтатусСканирования = "NO_LABEL" ИЛИ СтатусСканирования = "READ_ERROR"
		ИЛИ СтатусСканирования = "UNCERTAIN" Тогда
		Результат.Код = "MANUAL";
	КонецЕсли;
	Если Результат.Код <> "MATCH" И Ожидалось.Количество() > 0 Тогда
		Результат.Примечание = "по учёту числится: " + СтрСоединить(Ожидалось, ", ");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Ведомость(Идентификатор)
	Набор = РегистрыСведений.РэкСканСтрокиЗаданий.СоздатьНаборЗаписей();
	Набор.Отбор.Задание.Установить(Идентификатор);
	Набор.Прочитать();
	Строки = Новый Массив;
	Закрыто = Ложь;
	Для Каждого Запись Из Набор Цикл
		Закрыто = Закрыто ИЛИ Запись.Закрыто;
		Строки.Добавить(Новый Структура("address, expected, scan_status, found, verdict, flags, note, photo",
			Запись.Адрес, ИзСтрокиJSON(Запись.Ожидалось), Запись.СтатусСканирования,
			?(ПустаяСтрока(Запись.Найдено), Новый Массив, ИзСтрокиJSON(Запись.Найдено)),
			?(ПустаяСтрока(Запись.Вердикт), "NOT_SCANNED", Запись.Вердикт),
			?(ПустаяСтрока(Запись.Признаки), Новый Массив, ИзСтрокиJSON(Запись.Признаки)),
			Запись.Примечание, Запись.Фото));
	КонецЦикла;
	// Поле summary стенд считает сам, если его нет в ответе; здесь оно не формируется.
	Возврат Новый Структура("task_id, status, lines", Идентификатор, ?(Закрыто, "closed", "open"), Строки);
КонецФункции

#КонецОбласти

#Область Служебные

Функция ТелоКакСтруктура(Запрос)
	Текст = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Возврат ИзСтрокиJSON(Текст);
КонецФункции

Функция ИзСтрокиJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение);
КонецФункции

Функция ВСтрокуJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ОтветJSON(Значение, Код = 200)
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ВСтрокуJSON(Значение), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОтветОшибка(Код, Текст)
	Возврат ОтветJSON(Новый Структура("error", Текст), Код);
КонецФункции

#КонецОбласти
